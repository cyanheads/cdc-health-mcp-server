{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "cdc-health-mcp-server",
  "version": "0.11.0",
  "description": "Search and query CDC public health data — mortality, vaccinations, surveillance, behavioral risk (Socrata SODA API) via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/cdc-health-mcp-server#readme",
  "repository": "https://github.com/cyanheads/cdc-health-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cdc",
    "public-health",
    "socrata",
    "health-data",
    "typescript"
  ],
  "userConfig": {
    "CDC_APP_TOKEN": {
      "type": "string",
      "title": "Socrata app token",
      "description": "Optional app token for higher CDC Open Data (Socrata) rate limits. Register free at dev.socrata.com.",
      "sensitive": true,
      "default": ""
    }
  },
  "mcpServers": {
    "cdc-health-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/cdc-health-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "CDC_APP_TOKEN": "${user_config.CDC_APP_TOKEN}"
      }
    }
  }
}
