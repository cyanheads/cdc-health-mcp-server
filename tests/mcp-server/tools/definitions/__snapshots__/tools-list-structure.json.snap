    {
      "name": "cdc_query_wonder",
      "title": "Cdc Query Wonder",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "database": {
            "default": "underlying_1999_2020",
            "type": "string",
            "enum": [
              "underlying_1999_2020",
              "provisional",
              "underlying_2018_2024",
              "multiple_1999_2020",
              "multiple_2018_2024"
            ]
          },
          "group_by": {
            "default": [
              "year"
            ],
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "year",
                "age_group",
                "sex",
                "race",
                "icd_chapter",
                "icd_subchapter",
                "cause_113",
                "leading_causes",
                "injury_intent",
                "hispanic_origin",
                "month"
              ]
            }
          },
          "cause_icd10": {
            "anyOf": [
              {
                "type": "string",
                "const": ""
              },
              {
                "type": "string",
                "enum": [
                  "999--999",
                  "999-999"
                ]
              },
              {
                "type": "string",
                "pattern": "^[A-Z][0-9]{2}(\\.[0-9]+)?(-[A-Z][0-9]{2}(\\.[0-9]+)?)?$"
              },
              {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "999--999",
                        "999-999"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^[A-Z][0-9]{2}(\\.[0-9]+)?(-[A-Z][0-9]{2}(\\.[0-9]+)?)?$"
                    }
                  ]
                }
              }
            ]
          },
          "mcd_icd10": {
            "anyOf": [
              {
                "type": "string",
                "const": ""
              },
              {
                "type": "string",
                "enum": [
                  "999--999",
                  "999-999"
                ]
              },
              {
                "type": "string",
                "pattern": "^[A-Z][0-9]{2}(\\.[0-9]+)?(-[A-Z][0-9]{2}(\\.[0-9]+)?)?$"
              },
              {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "999--999",
                        "999-999"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^[A-Z][0-9]{2}(\\.[0-9]+)?(-[A-Z][0-9]{2}(\\.[0-9]+)?)?$"
                    }
                  ]
                }
              }
            ]
          },
          "sex": {
            "default": "all",
            "type": "string",
            "enum": [
              "all",
              "male",
              "female"
            ]
          },
          "age_groups": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "1",
                "1-4",
                "5-14",
                "15-24",
                "25-34",
                "35-44",
                "45-54",
                "55-64",
                "65-74",
                "75-84",
                "85+",
                "NS"
              ]
            }
          },
          "year_range": {
            "type": "object",
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 1999,
                "maximum": "current UTC year"
              },
              "to": {
                "type": "integer",
                "minimum": 1999,
                "maximum": "current UTC year"
              }
            },
            "required": [
              "from",
              "to"
            ]
          },
