                "dataType"
              ],
              "additionalProperties": false
            }
          },
          "totalCount": {
            "type": "number"
          },
          "truncated": {
            "type": "boolean"
          },
          "shown": {
            "type": "number"
          },
          "cap": {
            "type": "number"
          },
          "nextOffset": {
            "type": "number"
          },
          "notice": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "message": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "examples": [
                      "dataset_not_found",
                      "not_queryable",
                      "access_denied",
                      "invalid_query",
                      "rate_limited",
                      "upstream_error"
                    ]
                  },
                  "recovery": {
                    "type": "object",
                    "properties": {
                      "hint": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "hint"
                    ],
                    "additionalProperties": {}
                  },
                  "retryable": {
                    "type": "boolean"
                  }
