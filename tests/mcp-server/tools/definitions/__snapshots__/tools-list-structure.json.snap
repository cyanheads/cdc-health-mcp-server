{
  "tools": [
    {
      "name": "cdc_discover_datasets",
      "title": "Cdc Discover Datasets",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "domain": {
            "default": "data.cdc.gov",
            "type": "string",
            "enum": [
              "data.cdc.gov",
              "chronicdata.cdc.gov"
            ]
          },
          "query": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asset_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "dataset",
                "filter",
                "chart",
                "map",
                "story",
                "file",
                "href"
              ]
            }
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          },
          "order": {
            "type": "string",
            "enum": [
              "dataset_id",
              "relevance"
            ]
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "datasets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "assetType": {
                  "type": "string"
                },
                "permalink": {
                  "type": "string"
                },
                "downloadUrl": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "accessPoints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "label",
                      "url"
                    ],
                    "additionalProperties": false
                  }
                },
                "parentIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "category": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "columnCount": {
                  "type": "number"
                },
                "columnSample": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "updatedAt": {
                  "type": "string"
                },
                "pageViews": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "totalCount": {
            "type": "number"
          },
          "appliedFilters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assetTypes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "dataset",
                    "filter",
                    "chart",
                    "map",
                    "story",
                    "file",
                    "href"
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "notice": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "message": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "examples": [
                      "rate_limited",
                      "dataset_not_found",
                      "access_denied",
                      "upstream_error",
                      "page_out_of_range",
                      "invalid_query"
                    ]
                  },
                  "recovery": {
                    "type": "object",
                    "properties": {
                      "hint": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "hint"
                    ],
                    "additionalProperties": {}
                  },
                  "retryable": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": {}
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "not": {
              "required": [
                "error"
              ]
            },
            "required": [
              "datasets",
              "totalCount",
              "appliedFilters"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
